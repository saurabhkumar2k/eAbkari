    <script type="text/javascript">
 
        function toggleTable(ddl) {
            debugger;
            var catsub = document.getElementById('catsubf');
            var tabletestype = document.getElementById('itaba');
            /*var tabletttfirdateid = document.getElementById('firdateid');*/

           /* var tableCL = document.getElementById('clTable');*/
            

          var tablefirdateid = document.getElementById('ctl00_ContentPlaceHolder1_firdateid');
            

            var ddlTesting = document.getElementById('ctl00_ContentPlaceHolder1_ddl_testingtype');
            var optionToDisable = ddlTesting.querySelector('option[value="3"]'); // Complete Testing option


            var optionToDETAILD = ddlTesting.querySelector('option[value="1"]'); // DETAILD Testing option

            var optionTotesting = ddlTesting.querySelector('option[value="2"]'); // testing Testing option

            var ddcategry = document.getElementById('ctl00_ContentPlaceHolder1_ddlCategory');
            var ddSubcategry = document.getElementById('ctl00_ContentPlaceHolder1_ddlSubCategory');
            
    if (ddl.value === "1") { // CL selected
        table.style.display = 'none';        // hide the table
        //tableCL.style.display = 'none'; 
        tablefirdateid.style.display = "none";
        optionToDisable.disabled = true;      // disable "Complete Testing" option
      

        // Optional: if "Complete Testing" is selected, reset dropdown to first option
        if (ddlTesting.value === "3") {
            ddlTesting.value = ddlTesting.options[0].value;
            tablefirdateid.style.display = "none";
        }
    } else if (ddl.value === "0") {  // default select
        table.style.display = 'none';
        tablefirdateid.style.display = "none";
        optionToDisable.disabled = false;     // enable "Complete Testing" option
    }
    else if (ddl.value === "2") {  // default select
        //tableCL.style.display = 'none';
        tablefirdateid.style.display = "none";
        optionToDisable.disabled = false;     // enable "Complete Testing" option
    }
    else if (ddl.value === "4") {  // default select
    table.style.display = 'none';        // hide the table
    tabletestype.style.display = 'none';
   // tablefirdateid.style.display = 'table';
        optionToDisable.disabled = false;      // disable "Complete Testing" option
   
  
}



    else if (ddl.value === "5") {  // default select
        table.style.display = 'none';        // hide the table
        tabletestype.style.display = 'none';
        tablefirdateid.style.display = 'table';
        optionToDisable.disabled = true;      // disable "Complete Testing" option
       
       /* ddcategry.value = ddcategry.options[0].value;*/
    }


    else {
        table.style.display = 'table';
        /*tablefirdateid.style.display = "none";*/
        tablefirdateid.style.display = "none";
        optionToDisable.disabled = false;     // enable "Complete Testing" option
        optionToDETAILD.disabled = true; 
        optionTotesting.disabled = true; 
    }
}

        
  



        function cldata(dd) {



            var ddlTesting = document.getElementById('ctl00_ContentPlaceHolder1_ddl_testingtype');


             if (dd.value === '1') {  // '1' is the value for "CL"
                 ddlTesting.disabled = true;  // disable complete testing dropdown
             } else {
                 ddlTesting.disabled = false; // enable it for other selections
             }
         }


    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Your code here
            document.getElementById('catsub').style.display = 'none';
            /* document.getElementById('firdateid').style.display = 'none';*/
            var table = document.getElementById('ctl00_ContentPlaceHolder1_firdateid');
            table.style.display = "none";  // hide table
            debugger;
            var dd = document.getElementById('ctl00_ContentPlaceHolder1_ddllabtesttype');
           
            toggleTable(dd);


        });
    </script>





    
